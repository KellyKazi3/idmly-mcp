{
  "name": "idmly-mcp",
  "version": "0.1.3",
  "mcpName": "io.github.KellyKazi3/idmly-mcp",
  "description": "MCP server for idmly: convert a self-contained HTML design into an editable Adobe InDesign file (.idml) from Claude Code, Cursor, Codex, Windsurf or Claude Desktop.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "indesign",
    "idml",
    "html",
    "design",
    "claude",
    "cursor",
    "codex"
  ],
  "homepage": "https://www.idmly.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KellyKazi3/idmly-mcp.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "idmly-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run build && node --test --test-force-exit \"test/**/*.test.mjs\"",
    "prepublishOnly": "npm test",
    "start": "node dist/index.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.19.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^3.25.0"
  }
}
